{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zombietrend",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://zombietrend.org",
    "VITE_APP_NAME": "ZombieTrend AI",
    "VITE_APP_DESCRIPTION": "AI zombie love story video generator: turn two photos into the viral zombie hug trend for TikTok, Reels and Shorts.",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_DEFAULT_LOCALE": "en"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zombietrend-ai",
      "database_id": "5ad62fdf-c81a-4095-a0e6-abda98c25035",
      "migrations_dir": "drizzle"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "routes": [
    {
      "pattern": "zombietrend.org",
      "custom_domain": true
    }
  ]
}
